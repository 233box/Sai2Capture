<UserControl x:Class="Sai2Capture.Views.VideoRepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Sai2Capture.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:UniversalConverter x:Key="UniversalConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="视频修复"
                           Style="{StaticResource CardTitleStyle}"/>
                <TextBlock Text="检测视频中与参考帧相似的错误帧并用前一帧替换，修复视频损坏"
                           Foreground="{DynamicResource ui:BodyForegroundSecondaryBrush}"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ui:Card>

        <!-- 主体内容 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 视频文件选择 -->
            <ui:Card Grid.Row="0" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="视频文件：" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Margin="8,0"/>
                    <ui:Button Grid.Column="2"
                               Content="📂 浏览"
                               Command="{Binding SelectVideoCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=Invert}"/>
                </Grid>
            </ui:Card>

            <!-- 参考帧选择 -->
            <ui:Card Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="错误帧参考图：" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ReferenceImagePath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Margin="8,0"/>
                    <ui:Button Grid.Column="2"
                               Content="📂 浏览"
                               Command="{Binding SelectReferenceImageCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=Invert}"/>
                </Grid>
            </ui:Card>

            <!-- 参数设置 -->
            <ui:Card Grid.Row="2" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="相似度阈值：" VerticalAlignment="Center" FontSize="14"/>
                    <Slider Grid.Column="1"
                            Minimum="0.5"
                            Maximum="0.99"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Value="{Binding SimilarityThreshold}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=Invert}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SimilarityThreshold, StringFormat='{}{0:F2}'}"
                               VerticalAlignment="Center"
                               FontSize="14"/>
                    <TextBlock Grid.Column="2"
                               Text="（建议 0.80~0.90，越高越严格）"
                               Foreground="{DynamicResource ui:BodyForegroundSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="40,0,0,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <ui:Button Content="▶ 开始修复"
                                   Command="{Binding StartRepairCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToInvertedVisibility}"/>
                        <ui:Button Content="⏹ 取消"
                                   Command="{Binding CancelRepairCommand}"
                                   Appearance="Danger"
                                   Visibility="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToVisible}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 输出路径 -->
            <ui:Card Grid.Row="3" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输出路径：" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>
                    <ui:Button Grid.Column="2"
                               Content="📂 浏览"
                               Command="{Binding SelectOutputPathCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=Invert}"/>
                </Grid>
            </ui:Card>

            <!-- 进度与状态 -->
            <ui:Card Grid.Row="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 进度条 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="22"
                                     Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Progress, StringFormat='{}{0:F1}%'}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- 状态信息 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="状态：" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource ui:BodyForegroundSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 统计信息 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0">
                            <Run Text="总帧数：" FontWeight="SemiBold"/>
                            <Run Text="{Binding TotalFrames}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="2">
                            <Run Text="当前帧：" FontWeight="SemiBold"/>
                            <Run Text="{Binding CurrentFrame}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="4" Foreground="#E53935">
                            <Run Text="已修复：" FontWeight="SemiBold"/>
                            <Run Text="{Binding RemovedFrames}"/>
                            <Run Text=" 帧"/>
                        </TextBlock>
                    </Grid>

                    <!-- 帮助提示（初始状态） -->
                    <StackPanel Grid.Row="3"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0"
                                Visibility="{Binding TotalFrames, Converter={StaticResource UniversalConverter}, ConverterParameter=IntToCollapsed}">
                        <TextBlock Text="💡 使用说明"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource ui:BodyForegroundSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="1. 选择损坏的视频文件（支持 MP4、AVI、MOV、MKV）" FontWeight="Normal"/><LineBreak/>
                            <Run Text="2. 选择一张错误帧的截图（PNG/JPG），可以从视频中截取典型损坏帧" FontWeight="Normal"/><LineBreak/>
                            <Run Text="3. 调整相似度阈值（默认 0.85），值越高检测越严格" FontWeight="Normal"/><LineBreak/>
                            <Run Text="4. 设置输出路径，点击「开始修复」即可" FontWeight="Normal"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
