<UserControl x:Class="Sai2Capture.Views.VideoRepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Sai2Capture.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:UniversalConverter x:Key="UniversalConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="视频修复" FontWeight="SemiBold" FontSize="16" Foreground="#333333"/>
                <TextBlock Text="通过与参考帧对比，自动检测并移除视频中的错误/重复帧" FontSize="12" Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- 文件选择区域 -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="文件选择" Style="{StaticResource CardTitleStyle}"/>

                        <!-- 视频文件选择 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="视频文件:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1" Text="{Binding VideoPath}" IsReadOnly="True" FontWeight="Normal" Margin="0,0,12,0"/>
                            <ui:Button Grid.Column="2" Content="选择视频" Command="{Binding SelectVideoCommand}" Icon="Video24"/>
                        </Grid>

                        <!-- 输出路径 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="输出路径:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1" Text="{Binding OutputPath}" IsReadOnly="True" FontWeight="Normal"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 参考帧选择区域 -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="参考帧选择" Style="{StaticResource CardTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 当前参考帧预览 -->
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" 
                                   Background="#FAFAFA" Height="180" Margin="0,0,8,0">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding HasReferenceFrame, Converter={StaticResource UniversalConverter}, ConverterParameter=InverseBoolToVisible}">
                                        <ui:SymbolIcon Symbol="Image24" FontSize="32" Foreground="#CCCCCC"/>
                                        <TextBlock Text="未设置参考帧" Foreground="#999999" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding HasReferenceFrame, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToVisible}">
                                        <Image Source="{Binding ReferenceFrameImage}" Stretch="Uniform" Height="140"/>
                                        <TextBlock Text="{Binding ReferenceFrameInfo}" Foreground="#666666" FontSize="11" 
                                                  HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 视频预览 -->
                            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" 
                                   Background="#1E1E1E" Height="180" Margin="0,0,8,0">
                                <Grid>
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"/>
                                    <TextBlock Text="{Binding FrameTimeText}" Foreground="White" FontSize="14" 
                                              FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Margin="8" Padding="6,3" Background="#80000000"/>
                                </Grid>
                            </Border>

                            <!-- 选择按钮 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <ui:Button Content="从视频中选择帧"
                                          Command="{Binding OpenFrameSelectorCommand}"
                                          Appearance="Primary"
                                          Icon="ImageEdit24"
                                          Width="160"
                                          Margin="0,0,0,8"
                                          ToolTip="从视频中选择一帧作为参考"/>
                                <ui:Button Content="重新选择"
                                          Command="{Binding OpenFrameSelectorCommand}"
                                          Appearance="Secondary"
                                          Icon="ArrowSync24"
                                          Width="160"
                                          Visibility="{Binding HasReferenceFrame, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToVisible}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="提示：从视频中选择一帧正确的帧作为参考，系统将自动移除与该帧高度相似的错误帧。" 
                                  FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- 参数设置 -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="参数设置" Style="{StaticResource CardTitleStyle}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="相似度阈值:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" 
                                   Value="{Binding SimilarityThreshold}" 
                                   Minimum="0.5" Maximum="0.99" 
                                   SmallChange="0.01" LargeChange="0.1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                            <ui:TextBox Grid.Column="2" 
                                       Text="{Binding SimilarityThreshold, StringFormat={}{0:F2}}" 
                                       Width="80" 
                                       IsReadOnly="True"
                                       HorizontalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="阈值越高越严格。高于此值的帧将被视为错误帧并移除。" 
                                  FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                </ui:Card>

                <!-- 操作按钮 -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="操作" Style="{StaticResource CardTitleStyle}"/>

                        <!-- 修复条件提示 -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="Text" Value="请先选择视频并设置参考帧后，点击开始修复"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                            <Setter Property="Text" Value="正在处理中..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="开始修复"
                                      Command="{Binding StartRepairAsyncCommand}"
                                      Appearance="Primary"
                                      Icon="Play24"
                                      Width="120"
                                      Margin="0,0,12,0"/>

                            <ui:Button Content="取消"
                                      Command="{Binding CancelRepairCommand}"
                                      Appearance="Danger"
                                      Icon="Dismiss24"
                                      Width="100"
                                      Margin="0,0,12,0"
                                      IsEnabled="{Binding IsProcessing}"/>

                            <ui:Button Content="打开输出文件夹"
                                      Command="{Binding OpenOutputFolderCommand}"
                                      Icon="FolderOpen24"
                                      Width="140"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 处理进度 -->
                <ui:Card Margin="0,0,0,16" 
                        Visibility="{Binding IsProcessing, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToVisible}">
                    <StackPanel>
                        <TextBlock Text="处理进度" Style="{StaticResource CardTitleStyle}"/>

                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="24" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding ProgressText}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SimilarityText}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding RemovedFrames, StringFormat='已移除 {0} 帧'}" HorizontalAlignment="Center" Foreground="#E57373"/>
                        </Grid>

                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#666666" FontSize="12"/>
                    </StackPanel>
                </ui:Card>

                <!-- 使用说明 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="使用说明" Style="{StaticResource CardTitleStyle}"/>

                        <StackPanel>
                            <TextBlock Text="1. 选择需要修复的视频文件（支持 MP4/AVI/MKV/MOV 格式）" Margin="0,0,0,4"/>
                            <TextBlock Text="2. 点击「从视频中选择帧」，在视频中选择一帧正确的帧作为参考" Margin="0,0,0,4"/>
                            <TextBlock Text="3. 使用滑块或按钮浏览视频，找到并选择正确的帧" Margin="0,0,0,4"/>
                            <TextBlock Text="4. 调整相似度阈值（推荐 0.80-0.90），然后点击「开始修复」" Margin="0,0,0,4"/>
                            <TextBlock Text="5. 处理完成后，修复的视频会保存在原目录" Margin="0,0,0,4"/>
                        </StackPanel>

                        <TextBlock Text="原理：通过比较每一帧与参考帧的相似度，相似度超过阈值的帧被认为是错误帧或重复帧，将被移除并用前一有效帧替代。" 
                                  FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 帧选择器弹窗 -->
        <Grid Grid.Row="0" Grid.RowSpan="2" 
              Visibility="{Binding IsFrameSelectorOpen, Converter={StaticResource UniversalConverter}, ConverterParameter=BoolToVisible}">
            <!-- 半透明背景 -->
            <Border Background="#80000000"/>

            <!-- 帧选择器内容 -->
            <Border Background="White" CornerRadius="8" Margin="40" MaxWidth="800">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.3"/>
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" Text="选择参考帧" FontWeight="SemiBold" FontSize="18" Foreground="#333333" Margin="0,0,0,16"/>

                    <!-- 视频预览 -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" Height="320" Margin="0,0,0,16">
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"/>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
                                <TextBlock Foreground="White" FontSize="16" FontFamily="Consolas">
                                    <Run Text="帧: "/><Run Text="{Binding CurrentFrameIndex}"/>
                                    <Run Text=" / "/><Run Text="{Binding TotalFrames}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding FrameTimeText}" Foreground="#AAAAAA" FontSize="14" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 帧滑块 -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="|&lt;" Command="{Binding GoToStartCommand}" Width="50" Margin="0,0,8,0"
                                  ToolTip="跳转到开头"/>
                        <Slider Grid.Column="1" 
                               Value="{Binding CurrentFrameIndex}" 
                               Minimum="0" 
                               Maximum="{Binding TotalFrames}" 
                               SmallChange="1" LargeChange="30"
                               VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="2" Content="&gt;|" Command="{Binding GoToEndCommand}" Width="50" Margin="8,0,0,0"
                                  ToolTip="跳转到结尾"/>
                    </Grid>

                    <!-- 播放控制 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:Button Content="&lt; 上一帧" Command="{Binding PrevFrameCommand}" Width="100" Margin="0,0,8,0"
                                  ToolTip="后退一帧"/>
                        <ui:Button Content="后退 30 帧" Command="{Binding StepBackwardCommand}" 
                                  Width="100" Margin="0,0,8,0"/>
                        <ui:Button Content="前进 30 帧" Command="{Binding StepForwardCommand}" 
                                  Width="100" Margin="0,0,8,0"/>
                        <ui:Button Content="下一帧 &gt;" Command="{Binding NextFrameCommand}" Width="100"
                                  ToolTip="前进一帧"/>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Command="{Binding CloseFrameSelectorCommand}" 
                                  Appearance="Secondary" Width="100" Margin="0,0,12,0"/>
                        <ui:Button Content="设置此帧为参考" Command="{Binding SetReferenceFrameCommand}" 
                                  Appearance="Primary" Icon="Checkmark24" Width="140"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
